# Database Credentials
DATABASE_URL=postgresql://user:password@localhost:5432/deepverify

# External Service Tokens
HF_TOKEN=

# Storage Backend Selection: "local", "supabase", or "r2"
STORAGE_BACKEND=local

# Option A: Supabase Storage (1 GB free, NO credit card required)
# 1. Sign up free at supabase.com with GitHub
# 2. Project Settings -> API: Copy URL and anon/service_role key
# 3. Storage -> New Bucket: "deepverify-evidence" (mark Public if desired)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_NAME=deepverify-evidence

# Option B: Cloudflare R2 / S3 Object Storage (10 GB free)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

