!.agents/rules/

# Secrets & Environment Variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (includes uv-managed ml/.venv)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
# NOTE: uv.lock IS committed — it is the reproducible dependency lockfile for the ml/ package.


# Testing & Linting Caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Datasets & Media Files (NEVER commit raw or large media)
# data/raw/, data/processed/, and data/metadata/ are ignored — they contain raw images and
# large binary assets that must never enter the repository.
# data/splits/ is NOT ignored: immutable split manifests (lightweight CSV/JSON) are
# version-controlled so that reproducibility and remote/Colab execution are guaranteed.
# NOTE: Git cannot un-ignore a path inside a fully-ignored parent directory.
# Therefore we ignore each heavy subdirectory explicitly rather than using a blanket data/.
# Raw image binaries and archives must NEVER be placed under data/splits/.
data/raw/
data/processed/
data/metadata/
data/samples/video/
test_videos/
test_venv/
datasets/
raw_data/
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.wmv
*.h5
*.hdf5
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# Model Weights & Checkpoints (NEVER commit model weights)
weights/
checkpoints/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
*.pkl
*.pickle

# ML Experiment Logs & Tracking
runs/
wandb/
mlruns/
lightning_logs/
logs/
*.log

